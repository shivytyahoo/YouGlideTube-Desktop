# Maintainer: shivyt

pkgname=youglidetube-desktop
pkgver=1.0.0
pkgrel=1
# Release tags are v1.0.0 (or v1.0.0-beta1 for a beta); pkgver can't hold a "-".
_tag=${pkgver/beta/-beta}
_tag=${_tag/rc/-rc}
pkgdesc='YouTube and YouTube Music desktop client with Google sign-in'
arch=('x86_64' 'aarch64')
_github_repo='shivytyahoo/YouGlideTube-Desktop'
_repo="${_github_repo##*/}"
url="https://github.com/$_github_repo"
license=('GPL-3.0-only')
depends=(
  'cairo'
  'dbus'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gst-libav'
  'gst-plugins-bad'
  'gst-plugins-base'
  'gst-plugins-good'
  'gtk3'
  'hicolor-icon-theme'
  'libsoup3'
  'nodejs'
  'webkit2gtk-4.1'
)
makedepends=('libayatana-appindicator' 'pnpm' 'rust')
optdepends=('gst-plugins-ugly: more audio and video codecs'
            'libayatana-appindicator: music controls in the system tray')
conflicts=("$pkgname-bin")
# The release profile already strips symbols, so a debug package would be empty.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$_tag.tar.gz")
sha256sums=('96bf1ee079042b181102f8f32a866aef6546d99d03cbb49850abb50f376f431a')

# --- Shared youglidetube-desktop install steps: keep identical in every PKGBUILD. ---

# The release workflow builds every tag with a "-" (betas, release
# candidates) with src-tauri/tauri.prerelease.conf.json, which renames the app.
_youglidetube_product() {
  if [[ $_tag == *-* ]]; then
    printf 'YouGlideTube Beta'
  else
    printf 'YouGlideTube'
  fi
}

# Installs the data tree of a YouGlideTube .deb into $pkgdir.
_youglidetube_install() {
  local data=$1 product resdir desktop bin
  product=$(_youglidetube_product)
  resdir="$pkgdir/usr/lib/$product"
  desktop="$pkgdir/usr/share/applications/$product.desktop"

  cp -a --no-preserve=ownership "$data/usr" "$pkgdir/"
  if [[ ! -f $resdir/sidecar/integrity.cjs || ! -f $desktop ]]; then
    error "The .deb does not have the expected '$product' layout."
    return 1
  fi

  # The AUR ships one name for every channel: the .deb installs
  # /usr/bin/youglidetube, or /usr/bin/youglidetube-beta for betas.
  local bin
  for bin in youglidetube youglidetube-beta; do
    if [[ -e $pkgdir/usr/bin/$bin ]]; then
      mv "$pkgdir/usr/bin/$bin" "$pkgdir/usr/bin/youglidetube"
    fi
  done
  sed -Ei 's/^(Exec|StartupWMClass)=youglidetube(-beta)?( |$)/\1=youglidetube\3/' "$desktop"
  if [[ ! -x $pkgdir/usr/bin/youglidetube ]] ||
    grep -E '^Exec=' "$desktop" | grep -Evq '^Exec=youglidetube( |$)'; then
    error "Could not point $product.desktop at youglidetube."
    return 1
  fi

  # Tells YouGlideTube that pacman owns its updates, so the in-app updater stays off.
  install -m644 /dev/null "$resdir/distro-managed"
}

# --- End of shared steps. ---

# package.json pins pnpm 11.9.0 in "packageManager", and pnpm 11+ then
# downloads and re-runs that exact version by default (pmOnFail=download),
# outside makepkg's checksums and again for the nested `pnpm build` that
# Tauri starts. pnpm 12 keeps pnpm 11's lockfile format and settings, so use
# Arch's pnpm and only log the mismatch.
_youglidetube_pnpm_env() {
  export pnpm_config_pm_on_fail=warn
}

prepare() {
  cd "$_repo-$_tag"
  _youglidetube_pnpm_env
  pnpm install --frozen-lockfile

  cd src-tauri
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo-$_tag"
  _youglidetube_pnpm_env
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  export CARGO_NET_OFFLINE=true
  # makepkg sets RUSTFLAGS, and cargo then ignores the build.rustflags in
  # src-tauri/.cargo/config.toml, so repeat its cfg here.
  export RUSTFLAGS+=" --cfg reqwest_unstable"
  # The C parts of ring, aws-lc and SQLite are linked by rustc, which can't
  # read makepkg's slim LTO objects.
  export CFLAGS+=" -ffat-lto-objects"

  # Inline config instead of src-tauri/tauri.local.conf.json, which older tags
  # don't have: no updater artifacts, so no signing key is needed.
  local config=(--config '{"bundle":{"createUpdaterArtifacts":false}}')
  if [[ $_tag == *-* ]]; then
    config+=(--config src-tauri/tauri.prerelease.conf.json)
  fi
  pnpm tauri build --bundles deb "${config[@]}"
}

package() {
  cd "$_repo-$_tag"
  local debarch
  case $CARCH in
    x86_64) debarch=amd64 ;;
    aarch64) debarch=arm64 ;;
  esac

  mkdir -p "$srcdir/deb-data"
  bsdtar -xOf "src-tauri/target/release/bundle/deb/$(_youglidetube_product)_${_tag}_$debarch.deb" 'data.tar.*' |
    bsdtar -xf - -C "$srcdir/deb-data"
  _youglidetube_install "$srcdir/deb-data"
}
